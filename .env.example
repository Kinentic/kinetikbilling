# Listener ports
MLLP_PORT=2575
MLLP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_HOST=127.0.0.1

# SQLite database file (directory is created on start)
DB_PATH=data/kinetik.sqlite

# Billing provider identity placed in the 837P (2010AA) and submitter loops (1000A/1000B)
BILLING_NAME=KINETIK MEDICAL GROUP
BILLING_NPI=1234567893
BILLING_TAX_ID=123456789
BILLING_TAXONOMY=207Q00000X
BILLING_ADDRESS_LINE1=100 MAIN ST
BILLING_CITY=PORTLAND
BILLING_STATE=OR
BILLING_ZIP=97201
SUBMITTER_ID=KINETIK01
SUBMITTER_NAME=KINETIK BILLING
SUBMITTER_CONTACT_NAME=BILLING OFFICE
SUBMITTER_CONTACT_PHONE=5035550100
RECEIVER_ID=CLEARINGHOUSE
RECEIVER_NAME=CLEARINGHOUSE

# Coding (M1). coder: nothing reaches a claim without a coding task release. pass_through: DFT lines bill directly.
BILLING_MODE=coder
# Hours after an A03 discharge before a task still awaiting documentation is listed as overdue
DOCUMENTATION_GRACE_HOURS=48
# Share of releases routed to QA review, 0 to 100
QA_SAMPLE_PERCENT=0
